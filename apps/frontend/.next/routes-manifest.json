{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/candidate/[token]",
      "regex": "^/candidate/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/candidate/(?<nxtPtoken>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/candidates/[id]",
      "regex": "^/dashboard/candidates/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/candidates/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/jobs/[id]",
      "regex": "^/dashboard/jobs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/jobs/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/candidate",
      "regex": "^/candidate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/candidate(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/analytics",
      "regex": "^/dashboard/analytics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/analytics(?:/)?$"
    },
    {
      "page": "/dashboard/candidates",
      "regex": "^/dashboard/candidates(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/candidates(?:/)?$"
    },
    {
      "page": "/dashboard/interviews",
      "regex": "^/dashboard/interviews(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/interviews(?:/)?$"
    },
    {
      "page": "/dashboard/jobs",
      "regex": "^/dashboard/jobs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/jobs(?:/)?$"
    },
    {
      "page": "/dashboard/jobs/new",
      "regex": "^/dashboard/jobs/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/jobs/new(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/register",
      "regex": "^/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/register(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}